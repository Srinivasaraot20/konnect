diff --git a/rekonnect_project/settings.py b/rekonnect_project/settings.py
index d54d3d3..80f14be 100644
--- a/rekonnect_project/settings.py
+++ b/rekonnect_project/settings.py
@@ -120,6 +120,11 @@ STATIC_URL = 'static/'
 STATICFILES_DIRS = [BASE_DIR / 'static']
 STATIC_ROOT = BASE_DIR / 'staticfiles'
 
+# Long cache lifetime for our own static assets (style.css, main.js, images).
+# Bump this only if a static file's *content* changes without a filename
+# change, since browsers/CDNs will hold onto the old copy for a year.
+WHITENOISE_MAX_AGE = 31536000
+
 MEDIA_URL = 'media/'
 MEDIA_ROOT = BASE_DIR / 'media'
 
